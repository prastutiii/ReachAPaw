@using ReachAPaw.Models
@model IEnumerable<CommunityModel>
@{
    ViewData["Title"] = "Admin Community";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="~/css/admin/admincommunity.css" />

<div class="community-wrapper">

    <div class="greeting-card">
        <h2>Hi, Super Admin!</h2>
        <p>This is what's happening in our Reach.A.Paw community lately.</p>
    </div>

    <div class="page-header">
        <h4 class="section-title">Manage Community</h4>
        <button type="button" class="btn-add" onclick="showAddPostModal()">+ New Post</button>
    </div>

    <div class="posts-list">
        @if (Model != null && Model.Any())
        {
            @foreach (var post in Model)
            {
                <div class="post-row">
                    <div class="post-avatar">
                        @if (!string.IsNullOrEmpty(post.Users?.image_url))
                        {
                            <img src="@post.Users.image_url" alt="@post.Users.username" />
                        }
                        else
                        {
                            <div class="user-initial">@post.Users?.username?[0].ToString().ToUpper()</div>
                        }
                    </div>
                    <div class="post-info">
                        <h5>@post.title</h5>
                        <p class="post-meta">
                            <span class="author">@((post.Users?.username) ?? "Unknown")</span>
                            •
                            <span class="date">@post.created_at.ToString("MMM dd, yyyy")</span>
                        </p>
                    </div>
                    <div class="post-actions">
                        <button type="button" class="action-btn view-btn" onclick="showViewPostModal(@post.community_id)" title="View">👁</button>
                        <button type="button" class="action-btn delete-btn" onclick="showDeleteModal(@post.community_id, '@post.title')" title="Delete">🗑</button>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="no-data">No posts found.</p>
        }
    </div>
</div>

<!-- View Post Modal -->
<div class="modal-overlay" id="viewPostModal">
    <div class="modal">
        <button class="modal-close" onclick="hideViewPostModal()">&times;</button>
        <div id="viewPostContent"></div>
    </div>
</div>

<!-- Add Post Modal -->
<div class="modal-overlay" id="addPostModal">
    <div class="modal">
        <button class="modal-close" onclick="hideAddPostModal()">&times;</button>
        <h3>Add New Post</h3>
        <form method="post" asp-controller="AdminCommunity" asp-action="AddPost">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="title">Title *</label>
                <input type="text" id="title" name="title" placeholder="Post title" required />
            </div>
            <div class="form-group">
                <label for="category_id">Category *</label>
                <select id="category_id" name="category_id" required>
                    <option value="">Select Category</option>
                    @{
                        var categories = ViewBag.Categories as List<CategoryModel>;
                        if (categories != null)
                        {
                            @foreach (var category in categories)
                            {
                                <option value="@category.category_id">@category.category_name</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="post_content">Content *</label>
                <textarea id="post_content" name="post_content" placeholder="Write your post..." required></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="modal-btn-cancel" onclick="hideAddPostModal()">Cancel</button>
                <button type="submit" class="modal-btn-submit">Post</button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Post Modal -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal">
        <h3>Delete Post</h3>
        <p>Are you sure you want to delete the post <strong><span id="deletePostTitle"></span></strong>? This action cannot be undone.</p>
        <div class="modal-actions">
            <button type="button" class="modal-btn-cancel" onclick="hideDeleteModal()">Cancel</button>
            <form id="deleteForm" method="post" style="display: inline;">
                <button type="submit" class="modal-btn-delete">Delete</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // View Post Modal
        function showViewPostModal(postId) {
            fetch(`/AdminCommunity/GetPostData?id=${postId}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok: ' + response.statusText);
                    }
                    return response.json();
                })
                .then(data => {
                    const content = `
                        <div class="post-detail">
                            <div class="post-header">
                                <div class="post-avatar-detail">
                                    ${data.users?.image_url ? 
                                        `<img src="${data.users.image_url}" alt="${data.users.username}" />` :
                                        `<div class="user-initial">${data.users?.username?.charAt(0).toUpperCase() || 'U'}</div>`
                                    }
                                </div>
                                <div>
                                    <h4>${data.users?.username || 'Unknown'}</h4>
                                    <p class="date">${new Date(data.created_at).toLocaleDateString('en-US', {year: 'numeric', month: 'short', day: 'numeric'})}</p>
                                </div>
                            </div>
                            <div class="post-content-detail">
                                <h3>${data.title}</h3>
                                <p>${data.post_content || data.content}</p>
                            </div>
                        </div>
                    `;
                    document.getElementById('viewPostContent').innerHTML = content;
                    document.getElementById('viewPostModal').classList.add('show');
                })
                .catch(error => {
                    console.error('Error fetching post:', error);
                    alert('Error loading post. Please try again.');
                });
        }

        function hideViewPostModal() {
            document.getElementById('viewPostModal').classList.remove('show');
        }

        // Add Post Modal
        function showAddPostModal() {
            document.getElementById('addPostModal').classList.add('show');
        }

        function hideAddPostModal() {
            document.getElementById('addPostModal').classList.remove('show');
            document.getElementById('title').value = '';
            document.getElementById('category_id').value = '';
            document.getElementById('post_content').value = '';
        }

        // Delete Post Modal
        function showDeleteModal(postId, postTitle) {
            document.getElementById('deletePostTitle').textContent = postTitle;
            document.getElementById('deleteForm').action = '@Url.Action("DeletePost", "AdminCommunity")' + '?id=' + postId;
            document.getElementById('deleteModal').classList.add('show');
        }

        function hideDeleteModal() {
            document.getElementById('deleteModal').classList.remove('show');
        }

        // Close modals on overlay click
        document.querySelectorAll('.modal-overlay').forEach(modal => {
            modal.addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.remove('show');
                }
            });
        });
    </script>
}
