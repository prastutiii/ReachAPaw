@model ReachAPaw.Models.UserModel

@{
    ViewData["Title"] = "Edit Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/user/profile.css" />

<div class="container mt-5">
    <div class="row">
        <div class="col-md-5 mb-4">
            <div class="card p-4 shadow-sm">
                <div class="text-center mb-3">
                    <div class="border border-dark d-inline-block overflow-hidden" style="width: 200px; height: 150px;">
                        @if (!string.IsNullOrEmpty(Model.image_url))
                        {
                            <img src="@Model.image_url" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            <i class="bi bi-person-bounding-box fs-1 p-5"></i>
                        }
                    </div>
                </div>
                <div class="text-center">
                    <h4 class="fw-bold">@Model.username</h4>
                    <p class="text-muted small">Current Information</p>
                    <hr />
                    <p><strong>Email:</strong> @Model.email</p>
                    <p><strong>Address:</strong> @Model.address</p>
                    <p><strong>Phone:</strong> @Model.phone</p>
                </div>
            </div>
        </div>

        <div class="col-md-7 mb-4">
            <div class="card p-4 shadow-sm">
                <h5 class="fw-bold mb-4">Update Your Details</h5>

                <form asp-controller="Profile" asp-action="EditProfile" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="user_id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Username</label>
                        <input type="text" asp-for="username" class="form-control border-dark" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email Address</label>
                        <input type="email" asp-for="email" class="form-control border-dark" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Address</label>
                        <input type="text" asp-for="address" class="form-control border-dark" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Phone Number</label>
                        <input type="text" asp-for="phone" class="form-control border-dark" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Password</label>
                        <input type="text" asp-for="password" class="form-control border-dark" />
                    </div>

                    <div class="text-center mb-3">
                        <div class="border border-dark d-inline-block overflow-hidden" style="width: 200px; height: 150px;">
                            @if (!string.IsNullOrEmpty(Model.image_url))
                            {
                                <img src="@Model.image_url" style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <i class="bi bi-person-bounding-box fs-1 p-5"></i>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Upload New Profile Picture</label>
                        <input type="file" name="pfpFile" class="form-control border-dark" accept="image/*" />
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <a asp-action="Profile" class="btn btn-outline-secondary btn-outline-cancel me-2 px-4">Cancel</a>
                        <button type="submit" class="btn btn-dark btn-outline-dark px-5">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>