@model ReachAPaw.Models.UserModel

@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/user/profile.css" />

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card p-4">
                <div class="text-center mb-3">
                    <div class="border border-dark d-inline-block overflow-hidden" style="width: 200px; height: 150px;">
                        @if (!string.IsNullOrEmpty(Model.image_url))
                        {
                            <img src="@Model.image_url" style="width: 100%; height: 100%; object-fit: cover;" />
                        }
                        else
                        {
                            <i class="bi bi-person-bounding-box fs-1 p-5"></i>
                        }
                    </div>
                </div>
                <div class="text-center">
                    <h4 class="fw-bold">@Model.username</h4>
                    <p><strong>Email:</strong> @Model.email</p>
                    <p><strong>Address:</strong> @Model.address</p>
                    <p><strong>Phone:</strong> @Model.phone</p>

                    <div class="d-flex justify-content-between mt-4">
                        <a href="/Profile/EditProfile" class="btn btn-outline-dark px-4">Edit Profile</a>
                        <form asp-controller="Authentication" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-dark px-4">Logout</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card p-4 h-100">
                <h5 class="fw-bold mb-4">My Community</h5>

                @for (int i = 0; i < 2; i++)
                {
                    <div class="card mb-3 p-2 border-dark bg-light">
                        <div class="d-flex align-items-center mb-2">
                            <div class="rounded-circle bg-secondary me-2" style="width: 30px; height: 30px;"></div>
                            <div>
                                <h6 class="mb-0 small fw-bold">Pet Care Tips for New Pet Parents</h6>
                                <small class="text-muted">@@user_name • 2 hrs ago</small>
                            </div>
                        </div>
                        <p class="small text-muted mb-2">Lorem ipsum dolor sit amet, consectetur adipiscing elit...</p>
                        <div class="d-flex gap-3">
                            <span><i class="bi bi-heart"></i> 45</span>
                            <span><i class="bi bi-chat"></i> 20</span>
                        </div>
                    </div>
                }

                <div class="mt-auto text-end">
                    <a href="#" class="text-dark fw-bold text-decoration-none">See all...</a>
                </div>
            </div>
        </div>
    </div>
</div>