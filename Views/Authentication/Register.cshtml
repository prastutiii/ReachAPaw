@{
    ViewData["Title"] = "Register";
}

<link rel="stylesheet" href="~/css/authentication.css" />

<div class="auth-container">
    <img src="~/assets/logo.png" class="logo-img" alt="Logo" />
    <h2>Join Our Family!</h2>
    <p>Create an account to join your pet adoption journey</p>

    <form asp-controller="Authentication" asp-action="Register" method="post">
        <div class="form-grid">
            <div class="form-group full-width">
                <label>Name</label>
                <input type="text" name="username" placeholder="John Doe" required  />
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" placeholder="hello@example.com" required  />
                </div>
            <div class="form-group">
                <label>Address</label>
                <input type="text" name="address" placeholder="Maharajgunj" required  />
                </div>
            <div class="form-group">
                <label>Phone</label>
                <input type="tel" name="phone" placeholder="0000000000" required /></div>
            <div class="form-group">
                <label>Password</label><input type="password" name="password" placeholder="••••••••" required />
                </div>
        </div>
        <button type="submit" class="btn-submit">Sign Up</button>
    </form>

    <p class="footer-text">Already have an account? <a href="/Authentication/Login">Sign In</a></p>
</div>