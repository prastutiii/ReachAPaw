@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="~/css/authentication.css" />

<div class="auth-container" style="max-width: 450px;">
    <img src="~/assets/logo.png" class="logo-img" alt="Logo" />
    <h2>Welcome Back!</h2>
    <p>Sign in to continue your journey with us.</p>

    <form asp-controller="Authentication" asp-action="Login" method="post">
        <div class="form-grid login-mode">
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" placeholder="hello@example.com" required />
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" placeholder="••••••••" required />
            </div>
        </div>
        <button type="submit" class="btn-submit">Sign In</button>
    </form>

    <p class="footer-text">Don't have an account? <a href="/Authentication/Register">Sign up</a></p>
</div>