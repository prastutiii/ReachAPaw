@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/user/home.css" />
<link rel="stylesheet" href="~/css/user/adopt.css" />

<header class="hero-block">
    <div class="hero-text">
        <span class="mini-badge">Find your Pawfect Companion</span>
        <h1>Every Pet Deserves a <span class="highlight">Loving Home</span></h1>
        <p>Join our mission to connect every animal with a family that cares. We help you find the friend you've been waiting for.</p>
        <div class="action-row">
            <a href="/adopt/adopt" class="primary-pill">Adopt a Pet</a>
            <a href="/information/howtoadopt" class="ghost-pill">Learn More &rarr;</a>
        </div>
        <p class="waiting-counter">🐾@ViewBag.AvailablePetsCount+ pets waiting</p>
    </div>
    <div class="hero-frame">
        <img src="~/assets/animals.png" alt="img">
    </div>
</header>

<section class="impact-ribbon">
    <div class="stat-box"><h3>@ViewBag.AdoptedCount+</h3><p>Pets Adopted</p></div>
    <div class="stat-box"><h3>@ViewBag.HappyFamilies+</h3><p>Happy Families</p></div>
    <div class="stat-box"><h3>@ViewBag.ShelterCount+</h3><p>Partner Shelters</p></div>
    <div class="stat-box"><h3>@ViewBag.UserCount+</h3><p>Community Members</p></div>
</section>

<section class="pet-showcase">
    <div class="heading-center">
        <span class="mini-badge">Find Your Match</span>
        <h2>Adorable Pets Waiting for You</h2>
    </div>

    <div class="pet-grid">
        @if (ViewBag.FeaturedPets != null)
        {
            foreach (var pet in ViewBag.FeaturedPets)
            {
                <a class="pet-card" asp-controller="PetView" asp-action="PetView" asp-route-id="@pet.pet_id">
                    <div class="photo-wrap">
                        <img src="@(string.IsNullOrEmpty(pet.image_url) ? "/images/placeholder.jpg" : pet.image_url)" alt="@pet.pet_name">
                    </div>
                    <div class="pet-details">
                        <div class="name-line">
                            <h3 class="text">@pet.pet_name</h3>
                            <span class="gender-tag">@pet.gender</span>
                        </div>
                        <p>@pet.age old</p>
                    </div>
                </a>
            }
        }
    </div>

    <div class="center-btn">
        <a href="/adopt/adopt" class="ghost-pill">View All Pets</a>
    </div>
</section>

<section class="journey-map">
    <h2>Your Adoption Journey</h2>
    <div class="journey-steps">
        <div class="step-item">
            <div class="step-icon"><i class="bi bi-search"></i></div>
            <h3>Browse & Connect</h3>
            <p>Find your furry soulmate through our verified listings.</p>
        </div>
        <div class="step-item">
            <div class="step-icon"><i class="bi bi-chat-heart"></i></div>
            <h3>Meet & Greet</h3>
            <p>Schedule a visit to build a connection with your pet.</p>
        </div>
        <div class="step-item">
            <div class="step-icon"><i class="bi bi-house-heart"></i></div>
            <h3>Welcome Home</h3>
            <p>Finalize the paperwork and start your life together.</p>
        </div>
    </div>
</section>

<section class="event-hub">
    <h2>Community Events</h2>
    <div class="event-grid">
        @if (ViewBag.Events != null && ViewBag.Events.Count > 0)
        {
            foreach (var ev in ViewBag.Events)
            {
                <div class="event-card">
                    <h3>@ev.title</h3>
                    <p>
                        @(ev.post_content.Length > 100
                                        ? ev.post_content.Substring(0, 100) + "..." 
                                                        : ev.post_content)
                    </p>
                </div>
            }
            <div class="center-btn">
                <a href="/community/community" class="ghost-pill">Join Community</a>
            </div>
        }
        else
        {
            <div class="events">
                <p>No events available</p>
                <div class="center-btn">
                    <a href="/community/community" class="ghost-pill">Join Community</a>
                </div>
            </div>
        }
    </div>
</section>
