@model ReachAPaw.Models.PetModel
@{
    ViewData["Title"] = "Add New Pet";
    Layout = "~/Views/Shared/_ShelterLayout.cshtml";
}

<h2>Add New Pet</h2>

<form asp-action="AddPets" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label asp-for="pet_name"></label>
        <input asp-for="pet_name" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="species"></label>
        <select asp-for="species" class="form-control" required>
            <option value="">--Select Species--</option>
            <option value="Dog">Dog</option>
            <option value="Cat">Cat</option>
            <option value="Other">Other</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="gender"></label>
        <select asp-for="gender" class="form-control" required>
            <option value="">--Select Gender--</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="age"></label>
        <input asp-for="age" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="location"></label>
        <input asp-for="location" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="description"></label>
        <textarea asp-for="description" class="form-control" required></textarea>
    </div>

    <div class="form-group">
        <label asp-for="ideal_home"></label>
        <textarea asp-for="ideal_home" class="form-control" required></textarea>
    </div>

    <div class="form-group">
        <label asp-for="health_status"></label>
        <select asp-for="health_status" class="form-control" required>
            <option value="">--Select Status--</option>
            <option value="Excellent">Excellent</option>
            <option value="Good">Good</option>
            <option value="Average">Average</option>
            <option value="Bad">Bad</option>
        </select>
    </div>

    <div class="form-group">
        <label>Vaccinated:</label>
        <input type="radio" asp-for="is_vaccinated" value="True" /> Yes
        <input type="radio" asp-for="is_vaccinated" value="False" /> No
    </div>

    <div class="form-group">
        <label>Neutered:</label>
        <input type="radio" asp-for="is_neutered" value="True" /> Yes
        <input type="radio" asp-for="is_neutered" value="False" /> No
    </div>

    <div class="form-group">
        <label>Microchipped:</label>
        <input type="radio" asp-for="is_microchipped" value="True" /> Yes
        <input type="radio" asp-for="is_microchipped" value="False" /> No
    </div>

    <div class="form-group">
        <label asp-for="status"></label>
        <select asp-for="status" class="form-control" required>
            <option value="">--Select Status--</option>
            <option value="Available">Available</option>
            <option value="Pending">Pending</option>
            <option value="Adopted">Adopted</option>
            <option value="Unavailable">Unavailable</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="fee"></label>
        <input asp-for="fee" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Pet Image:</label>
        <input type="file" name="pet_file" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Add Pet</button>
</form>