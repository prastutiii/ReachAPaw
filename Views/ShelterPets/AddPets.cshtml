@model ReachAPaw.Models.PetModel
@{
    ViewData["Title"] = "Add New Pet";
    Layout = "~/Views/Shared/_ShelterLayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="~/css/shelter/shelterpets.css" />

<h2>Add New Pet</h2>

<form asp-controller="ShelterPets" asp-action="AddPets" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label>Pet Name:</label>
        <input name="pet_name" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Species</label>
            <label><input type="radio" name="species" value="Dog" required> Dog</label>
            <label><input type="radio" name="species" value="Cat"> Cat</label>
            <label><input type="radio" name="species" value="Cattle"> Cattle</label>
            <label><input type="radio" name="species" value="Other"> Other</label>
    </div>

    <div class="form-group">
        <label>Gender</label>
        <label><input type="radio" name="gender" value="Male" required> Male</label>
        <label><input type="radio" name="gender" value="Female"> Female</label>
    </div>

    <div class="form-group">
        <label>Age: </label>
        <input name="age" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Location: </label>
        <input name="location" class="form-control" />
    </div>

    <div class="form-group">
        <label>Description:</label>
        <textarea name="description" class="form-control" required></textarea>
    </div>

    <div class="form-group">
        <label>Ideal Home: </label>
        <textarea name="ideal_home" class="form-control" required></textarea>
    </div>

    <div class="form-group">
        <label>Health Status: </label>
        <label><input type="radio" name="health_status" value="Excellent" required> Excellent</label>
        <label><input type="radio" name="health_status" value="Good" required> Good</label>
        <label><input type="radio" name="health_status" value="Average" required> Average</label>
        <label><input type="radio" name="health_status" value="Bad" required> Bad</label>
    </div>

    <div class="form-group">
        <label>Vaccinated:</label>
        <label><input type="radio" name="is_vaccinated" value="True" required> Yes</label>
        <label><input type="radio" name="is_vaccinated" value="False" required> No</label>
    </div>

    <div class="form-group">
        <label>Neutered:</label>
        <label><input type="radio" name="is_neutered" value="True" required> Yes</label>
        <label><input type="radio" name="is_neutered" value="False" required> No</label>
    </div>

    <div class="form-group">
        <label>Microchipped:</label>
        <label><input type="radio" name="is_microchipped" value="True" required> Yes</label>
        <label><input type="radio" name="is_microchipped" value="False" required> No</label>
    </div>

    <div class="form-group">
        <label>Status: </label>
        <label><input type="radio" name="status" value="Available" required> Available</label>
        <label><input type="radio" name="status" value="Pending" required> Pending</label>
        <label><input type="radio" name="status" value="Adopted" required> Adopted</label>
        <label><input type="radio" name="status" value="Unvailable" required> Unvailable</label>
    </div>

    <div class="form-group">
        <label>Fee: </label>
        <input name="fee" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Pet Image: </label>
        <div class="upload-area">
            <input type="file" name="pet_file" id="pet_file" required hidden />
            <label for="pet_file" class="upload-label">
                <i class="fas fa-cloud-upload-alt"></i>
                <span>Click to upload or drag and drop</span>
            </label>
        </div>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Add Pet</button>
</form>