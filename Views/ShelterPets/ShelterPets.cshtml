@model IEnumerable<ReachAPaw.Models.PetModel>
@{
    ViewData["Title"] = "ShelterPets";
    Layout = "~/Views/Shared/_ShelterLayout.cshtml";

    var filter = Context.Request.Query["filter"].ToString();
    if (string.IsNullOrEmpty(filter)) filter = "all";

    var filtered = filter == "all" ? Model : Model.Where(p => p.status.ToLower().Trim() == filter.ToLower().Trim());
}

<link rel="stylesheet" href="~/css/shelter/shelterdash.css" />
<link rel="stylesheet" href="~/css/shelter/shelterpets.css" />

<div class="welcome">
    <h2>Hello, Shelter Admin!</h2>
    <h6>Here is the information about your pets.</h6>
</div>

<a href="/ShelterPets/AddPets" class="add">Add New Pet</a>

<div class="tabs-wrapper">
    <div class="tabs">
        <a href="?filter=all" class="tab @(filter == "all" ? "active" : "")">All <span class="count">@Model.Count()</span></a>
        <a href="?filter=Available" class="tab @(filter == "Available" ? "active" : "")">Available <span class="count">@Model.Count(p => p.status.ToLower().Trim() == "available")</span></a>
        <a href="?filter=Pending" class="tab @(filter == "Pending" ? "active" : "")">Pending <span class="count">@Model.Count(p => p.status.ToLower().Trim() == "pending")</span></a>
        <a href="?filter=Adopted" class="tab @(filter == "Adopted" ? "active" : "")">Adopted <span class="count">@Model.Count(p => p.status.ToLower().Trim() == "adopted")</span></a>
        <a href="?filter=Unavailable" class="tab @(filter == "Unavailable" ? "active" : "")">Unavailable <span class="count">@Model.Count(p => p.status.ToLower().Trim() == "unavailable")</span></a>
    </div>
</div>

<div class="pet-container">
    @if (filtered != null && filtered.Any())
    {
        @foreach (var pet in filtered)
        {
            <div class="pet-card">
                <div class="photo-wrap">
                    <img src="@(string.IsNullOrEmpty(pet.image_url) ? "/images/placeholder.jpg" : pet.image_url)" alt="@pet.pet_name">
                </div>
                <div class="pet-details">
                    <div class="name-line">
                        <h3>@pet.pet_name</h3>
                        <span class="gender-tag">@pet.gender</span>
                    </div>
                    <p>@pet.species • @pet.age old • @pet.location</p>
                    <div class="admin-actions">
                        <a asp-controller="ShelterPets" asp-action="ViewPets" asp-route-id="@pet.pet_id" class="action-btn view">View</a>
                        <a asp-controller="ShelterPets" asp-action="EditPet" asp-route-id="@pet.pet_id" class="action-btn edit">Edit</a>
                        <a asp-controller="ShelterPets" asp-action="DeletePet" asp-route-id="@pet.pet_id"
                           class="action-btn delete"
                           onclick="return confirm('Delete @pet.pet_name?')">Delete</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <p class="no-pets">No @(filter == "all" ? "" : filter) pets found.</p>
    }
</div>